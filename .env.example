# Desenvolvimento local (sem /api/mobile — os endpoints já incluem esse prefixo).
# O PWA em m.agendaedully.com.br usa a API de produção no build Docker:
# deploy/mobile/.env → https://app.agendaedully.com.br
EXPO_PUBLIC_API_URL=https://demo.agendaedully.com.br
#
# Homologação:
# EXPO_PUBLIC_API_URL=https://homolog.agendaedully.com.br
#
# Produção (API Laravel) — usada pelo PWA:
# EXPO_PUBLIC_API_URL=https://app.agendaedully.com.br
#
# Local:
# EXPO_PUBLIC_API_URL=http://192.168.0.39:8000

# Importante para APK (EAS):
# O arquivo .env NÃO sobe no EAS Build (está no .gitignore).
# A URL usada no APK vem de eas.json → build.<perfil>.env

# Importante para PWA (Docker na VPS):
# A URL é passada no build: deploy/mobile/docker-compose.yml → ARG EXPO_PUBLIC_API_URL

# Opcional: projectId do EAS (ajuda getExpoPushTokenAsync em builds)
# EXPO_PUBLIC_EAS_PROJECT_ID=7a0d3c58-7cff-442a-9a37-a2fe9eb85616

# Opcional: quando o app estiver nas lojas, preencha para mostrar os botões no banner
# EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.anonymous.edulyapp
# EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idSEU_ID
